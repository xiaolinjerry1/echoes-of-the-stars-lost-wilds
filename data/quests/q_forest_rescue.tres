offer_lines = Array[String](["营地的东边不太平，狼群又多了。", "有个巡林者去了东边森林，到现在还没回来。", "去找找他，顺手清掉几只狼——拜托了。"])
complete_lines = Array[String](["他平安回来了，多亏了你。", "这把备用的剑给你，路上小心。"])
