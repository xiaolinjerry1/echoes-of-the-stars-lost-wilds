offer_lines = Array[String](["霜灯的力量，要用得巧。", "先用冰环冻住敌人，再横扫打出「碎冰」——去练练手。", "西边有头异常强壮的苔牙野猪，小心它的冲锋。"])
complete_lines = Array[String](["碎冰……好漂亮的收招。", "这柄「霜痕之刃」配得上你。", "苔冠巨兽就在营地北方的林间遗迹，地图标着「兽」，沿路走过去就能找到。"])
