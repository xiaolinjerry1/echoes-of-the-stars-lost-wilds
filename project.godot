; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="群星回响：失落原野"
config/description="第三人称中世纪奇幻割草生存游戏 · 飞镖师"
config/version="1.0.0"
run/main_scene="res://scenes/app/main_menu.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="res://audio/default_bus_layout.tres"

[autoload]

AppFlow="*res://core/app_flow.gd"
DataRegistry="*res://core/data_registry.gd"
SaveService="*res://core/save_service.gd"
SettingsService="*res://core/settings_service.gd"
AudioService="*res://core/audio_service.gd"
DebugTools="*res://dev/debug_tools.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray()

[filesystem]

import/blender/enabled=false

